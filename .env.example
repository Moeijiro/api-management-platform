# ---------------------------------------------------------------------------
# API Management Platform - example environment
# Copy to backend/.env and adjust. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000   # shown in the documentation examples

# --- Database ----------------------------------------------------------------
# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/api_platform
DATABASE_URL=sqlite:///./api_platform.db

# --- Security ----------------------------------------------------------------
# Signs dashboard sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true

# --- API keys and rate limiting ----------------------------------------------
# Prefix of generated keys: <API_KEY_PREFIX>_<random>
API_KEY_PREFIX=dev_live
# Default quota for a new key; each key can be given its own value.
DEFAULT_RATE_LIMIT_PER_MINUTE=60
MAX_KEYS_PER_USER=10

# --- Request logging ----------------------------------------------------------
# Logs are written by a background writer in batches, so logging never sits on
# the request path. Tune how often it flushes.
LOG_FLUSH_INTERVAL_SECONDS=0.5
LOG_BATCH_SIZE=100
# Drop the oldest logs beyond this age when the cleanup command runs (0 = keep).
LOG_RETENTION_DAYS=30
# Store the caller's IP address with each request log.
LOG_CLIENT_IP=true
